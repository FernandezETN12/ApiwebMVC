@model IReadOnlyCollection<ApiwebMVC.Models.Pedido>

@{
    ViewData["Title"] = "Mi perfil";
}

<section class="profile-page">
    <p class="eyebrow eyebrow-dark">Mi cuenta</p>
    <h1>Hola, @ViewBag.Nombre</h1>

    <div class="profile-grid">
        <article class="profile-card">
            <h2>Datos personales</h2>
            <dl class="profile-details">
                <dt>Nombre</dt>
                <dd>@ViewBag.Nombre</dd>
                <dt>Correo</dt>
                <dd>@ViewBag.Email</dd>
                <dt>Cliente</dt>
                <dd>#@ViewBag.ClienteId</dd>
                <dt>Rol</dt>
                <dd>@ViewBag.Rol</dd>
            </dl>
        </article>

        <article class="profile-card profile-orders-card">
            <h2>Mis pedidos</h2>
            @if (Model.Count == 0)
            {
                <p>Aún no realizaste pedidos.</p>
                <a class="btn btn-primary" asp-controller="Menu" asp-action="Index">Ver el menú</a>
            }
            else
            {
                <div class="profile-orders">
                    @foreach (var pedido in Model)
                    {
                        <article class="profile-order">
                            <div class="profile-order__heading">
                                <strong>Pedido #@pedido.Id</strong>
                                <span class="badge @EstadoTexto.Badge(pedido.Estado)">@EstadoTexto.De(pedido.Estado)</span>
                            </div>
                            <ul>
                                @foreach (var detalle in pedido.Detalles)
                                {
                                    <li>@detalle.Cantidad × @(detalle.Pizza?.Nombre ?? $"Producto {detalle.PizzaId}")</li>
                                }
                            </ul>
                            <div class="profile-order__footer">
                                <span>@pedido.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                <strong>$@pedido.Total.ToString("N0")</strong>
                            </div>
                            @if (pedido.Estado == EstadoPedido.EsperaDeConfirmacion)
                            {
                                <form asp-controller="PedidosPage" asp-action="Cancelar" method="post" onsubmit="return confirm('¿Cancelar el pedido #@pedido.Id?');">
                                    <input type="hidden" name="id" value="@pedido.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar pedido</button>
                                </form>
                            }
                        </article>
                    }
                </div>
            }
        </article>
    </div>
</section>
