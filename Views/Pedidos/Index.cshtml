@model ApiwebMVC.Models.PedidoIndexViewModel

@{
    ViewData["Title"] = "Mi pedido";
}

<div class="container py-4">
    <h1 class="h2 mb-4">Mi pedido</h1>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    @if (Model.Items.Count == 0)
    {
        <p class="mb-4">Todavía no agregaste productos.</p>
        <a asp-controller="Menu" asp-action="Index" class="btn btn-primary">Ver menú</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="PedidosPage" asp-action="Index" class="btn btn-outline-secondary">Ver mis pedidos</a>
        }
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th class="text-end">Precio</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-end">Subtotal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>@item.Pizza.Nombre</strong>
                                <div class="small text-muted">@item.Pizza.Categoria</div>
                            </td>
                            <td class="text-end">$@item.Pizza.Precio.ToString("N0")</td>
                            <td>
                                <form asp-action="UpdateQuantity" method="post" class="d-flex justify-content-center gap-2 js-auto-submit-quantity">
                                    <input type="hidden" name="pizzaId" value="@item.Pizza.Id" />
                                    <input type="number" name="cantidad" value="@item.Cantidad" min="1" max="99"
                                           class="form-control form-control-sm" style="max-width: 88px" aria-label="Cantidad de @item.Pizza.Nombre" />
                                </form>
                            </td>
                            <td class="text-end">$@item.Subtotal.ToString("N0")</td>
                            <td class="text-end">
                                <form asp-action="Remove" method="post">
                                    <input type="hidden" name="pizzaId" value="@item.Pizza.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Quitar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end">Total</th>
                        <th class="text-end">$@Model.Total.ToString("N0")</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <section class="border-top pt-4">
            <h2 class="h4 mb-3">Datos de entrega</h2>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <div class="alert alert-info">
                    Para confirmar el pedido tenés que iniciar sesión. Tu carrito se guarda mientras tanto.
                </div>
                <a class="btn btn-primary" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Pedidos">Iniciar sesión para confirmar</a>
                <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-secondary">Seguir comprando</a>
            }
            else
            {
                <form asp-action="Confirmar" method="post">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="ClienteNombre" class="form-label">Nombre</label>
                            <input asp-for="ClienteNombre" class="form-control" readonly />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ClienteTelefono" class="form-label">Teléfono</label>
                            <input asp-for="ClienteTelefono" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="ClienteTelefono" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ClienteDireccion" class="form-label">Dirección</label>
                            <input asp-for="ClienteDireccion" class="form-control" autocomplete="street-address" />
                            <span asp-validation-for="ClienteDireccion" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Confirmar pedido · $@Model.Total.ToString("N0")</button>
                        <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-secondary">Seguir comprando</a>
                    </div>
                </form>
            }
        </section>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}