@model IEnumerable<ApiwebMVC.Models.Pizza>

@{
    ViewData["Title"] = "Menú";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h2 class="mb-2">Nuestro Menú</h2>
            <p class="text-muted">Selecciona tu pizza favorita</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    <nav class="mb-4 d-flex flex-wrap gap-2" aria-label="Categorías del menú">
        <a class="btn btn-outline-dark" asp-action="Index">Todo</a>
        <a class="btn btn-outline-dark" asp-action="Index" asp-route-categoria="Pizzas">Pizzas</a>
        <a class="btn btn-outline-dark" asp-action="Index" asp-route-categoria="Empanadas">Empanadas</a>
        <a class="btn btn-outline-dark" asp-action="Index" asp-route-categoria="Bebidas">Bebidas</a>
    </nav>

    <div class="row">
        @foreach (var pizza in Model)
        {
            <div class="col-sm-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">

                    @if (!string.IsNullOrWhiteSpace(pizza.ImagenURL))
                    {
                        <img src="@pizza.ImagenURL"
                                class="card-img-top @(string.Equals(pizza.Categoria, "Bebidas", StringComparison.OrdinalIgnoreCase) ? "drink-img" : string.Empty)"
                             alt="@pizza.Nombre"
                             style="height: 220px; object-fit: cover;" />
                    }

                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">@pizza.Nombre</h5>

                        <p class="card-text text-muted">
                            @pizza.Descripcion
                        </p>

                        @if (!string.Equals(pizza.Categoria, "Bebidas", StringComparison.OrdinalIgnoreCase)
                            && pizza.Ingredientes?.Any() == true)
                        {
                            <div class="mb-3">
                                @foreach (var ing in pizza.Ingredientes)
                                {
                                    <span class="badge bg-secondary me-1">
                                        @ing
                                    </span>
                                }
                            </div>
                        }

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <strong class="fs-5">
                                $@pizza.Precio.ToString("N0")
                            </strong>

                            <div class="d-flex gap-2">
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-controller="Menu"
                                   asp-action="Edit"
                                   asp-route-id="@pizza.Id">
                                    Editar
                                </a>

                                <form asp-controller="Menu" asp-action="Add" method="post"
                                      class="js-add-to-cart" data-product-name="@pizza.Nombre">
                                    <input type="hidden" name="pizzaId" value="@pizza.Id" />
                                    <button class="btn btn-sm btn-primary" type="submit">Añadir al carrito</button>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>