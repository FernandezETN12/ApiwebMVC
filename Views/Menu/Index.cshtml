@model IEnumerable<ApiwebMVC.Models.Pizza>

@{
    ViewData["Title"] = "Menú";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h2 class="mb-2">Nuestro Menú</h2>
            <p class="text-muted">Selecciona tu pizza favorita</p>
        </div>
    </div>

    <div class="row">
        @foreach (var pizza in Model)
        {
            <div class="col-sm-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">

                    @if (!string.IsNullOrWhiteSpace(pizza.ImagenURL))
                    {
                        <img src="@pizza.ImagenURL"
                             class="card-img-top"
                             alt="@pizza.Nombre"
                             style="height: 220px; object-fit: cover;" />
                    }

                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">@pizza.Nombre</h5>

                        <p class="card-text text-muted">
                            @pizza.Descripcion
                        </p>

                        <div class="mb-3">
                            @foreach (var ing in pizza.Ingredientes)
                            {
                                <span class="badge bg-secondary me-1">
                                    @ing
                                </span>
                            }
                        </div>

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <strong class="fs-5">
                                $@pizza.Precio
                            </strong>

                            <a class="btn btn-sm btn-primary" href="#">
                                Añadir
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>