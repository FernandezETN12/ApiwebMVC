@model IReadOnlyCollection<ApiwebMVC.Models.Pedido>

@{
    ViewData["Title"] = "Mis pedidos";
}

<section class="profile-page">
    <p class="eyebrow eyebrow-dark">Seguimiento</p>
    <h1>Mis pedidos</h1>

    @if (TempData["SuccessMessage"] is string ok)
    {
        <div class="alert alert-success" role="status">@ok</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (Model.Count == 0)
    {
        <p>No hay pedidos asociados a tu cuenta.</p>
        <a class="btn btn-primary" asp-controller="Menu" asp-action="Index">Elegir pizzas</a>
    }
    else
    {
        @foreach (var pedido in Model)
        {
            <article class="profile-card mb-3">
                <h2>Pedido #@pedido.Id</h2>
                <p>Estado: <span class="badge @EstadoTexto.Badge(pedido.Estado)">@EstadoTexto.De(pedido.Estado)</span></p>
                <ul class="mb-2">
                    @foreach (var detalle in pedido.Detalles)
                    {
                        <li>@detalle.Cantidad × @(detalle.Pizza?.Nombre ?? $"Producto {detalle.PizzaId}") — $@((detalle.Cantidad * detalle.PrecioUnitario).ToString("N0"))</li>
                    }
                </ul>
                <p>Total: <strong>$@pedido.Total.ToString("N0")</strong></p>
                <p>Fecha: @pedido.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                @if (pedido.Estado == EstadoPedido.EsperaDeConfirmacion)
                {
                    <form asp-action="Cancelar" method="post" onsubmit="return confirm('¿Cancelar el pedido #@pedido.Id?');">
                        <input type="hidden" name="id" value="@pedido.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar pedido</button>
                    </form>
                }
            </article>
        }
    }
</section>
