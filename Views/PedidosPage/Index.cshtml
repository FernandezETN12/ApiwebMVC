@model IReadOnlyCollection<ApiwebMVC.Models.Pedido>

@{
    ViewData["Title"] = "Mis pedidos";
}

<section class="profile-page">
    <p class="eyebrow eyebrow-dark">Seguimiento</p>
    <h1>Mis pedidos</h1>

    @if (Model.Count == 0)
    {
        <p>No hay pedidos asociados a tu cuenta.</p>
        <a class="btn btn-primary" asp-controller="Menu" asp-action="Index">Elegir pizzas</a>
    }
    else
    {
        @foreach (var pedido in Model)
        {
            <article class="profile-card mb-3">
                <h2>Pedido #@pedido.Id</h2>
                <p>Estado: <strong>@pedido.Estado</strong></p>
                <p>Total: <strong>$@pedido.Total.ToString("N2")</strong></p>
                <p>Fecha: @pedido.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
            </article>
        }
    }
</section>
